#!/usr/bin/env bash
# Wire this checkout into the devcontainer's baked-in Home Assistant install.
#
# Use the official HA image from .devcontainer/devcontainer.json. Its
# 2026.10.0.dev202609290227 minimum matches hacs.json and provides the ToolResult API.
# HA and runtime dependencies are already installed; only dev tools are added.
set -euo pipefail

cd "$(dirname "$0")/.."

pip3 install --no-cache-dir ruff pytest-asyncio

mkdir -p config
if [ ! -f config/configuration.yaml ]; then
  cat > config/configuration.yaml <<'YAML'
# naver_map devcontainer configuration.
homeassistant:
  name: naver_map Dev
  latitude: 37.5665
  longitude: 126.9780
  elevation: 0
  unit_system: metric
  time_zone: Asia/Seoul
  external_url: "http://localhost:8123"
  internal_url: "http://localhost:8123"

default_config:

http:
  server_port: 8123

logger:
  default: info
  logs:
    custom_components.naver_map: debug
YAML
fi

# Symlink the integration into HA's config dir so edits hot-reload.
mkdir -p config/custom_components
ln -sfn "$PWD/custom_components/naver_map" config/custom_components/naver_map

echo "Setup complete."
echo "  scripts/develop  → run HA from this checkout (port 8123)"
echo "  scripts/test     → run ruff + pytest"
